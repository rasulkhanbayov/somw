# Cluster-specific settings. Edit the <PLACEHOLDERS> once; every script sources this file.
# Account/QOS for #SBATCH headers cannot come from here (Slurm reads headers before
# any shell runs), so those are filled into the scripts by slurm/configure.sh.

# Absolute path of this project folder (the "4/" directory) on the cluster.
export PROJECT_ROOT="/export/home/rakh90100/cvpr_physics_plausibility/4"
# Large storage for the PhysCtrl checkout, checkpoints, test set, OOD data, generations.
# Expect ~20 GB for Phases 0-2 (checkpoints ~2 GB without the video model, test set ~1 GB,
# generations ~6 GB, OOD ~3 GB).
export DATA_ROOT="/export/home/rakh90100/cvpr_physics_plausibility/data"

# Big artefacts (Oct 14, 2026, user's rule): anything large and new goes to the hbku-research
# NFS share (10 TB, 4.2 TB free), not to the shared home (153 GB free on Oct 14). That covers the
# video model, rendered videos, new large datasets. DATA_ROOT keeps the existing data.
export BIG_ROOT="/export/hbku-research/rakh90100/somw"
# Video renderer weights (cogshader5B/, lgm_fp16.safetensors, sam_vit_h_4b8939.pth), from
# 00_setup_env.sh with DOWNLOAD_RENDER=1.
export RENDER_CKPT_DIR="$BIG_ROOT/checkpoints/checkpoints"

export PHYSCTRL_ROOT="$DATA_ROOT/physctrl"
export WARP_CACHE_DIR="$DATA_ROOT/warp_cache"
export HF_HOME="$DATA_ROOT/hf_cache"
export SOMW_RESULTS="$PROJECT_ROOT/results"

# Conda: same layout as the previous project (per-project env name).
export CONDA_DIR="$HOME/miniconda3"
export ENV_NAME="somw"
# ~/.local/lib/python3.10 holds ~270 packages from other projects (incl. torch 2.5.1 and
# numpy 2.x). With the user site enabled they shadow the env's own packages, and on
# Oct 10 they made setup skip installing torch into the env. Every script sources this file.
export PYTHONNOUSERSITE=1

# CUDA toolkit modules, copied from previous_prj_slurm_files/ (A100 vs H200 nodes).
export A100_CUDA_MODULE="cuda12.1/toolkit/12.1.1"
export H200_CUDA_MODULE="cuda12.6/toolkit/12.6.2"
